        "name": "run",
        "kind": "references",
        "source": "agency.service.Session",
        "target": "agency.runs.Run",
        "cardinality": "one",
        "via": "run_id"
      }
    },
    "token_digest": {
      "$ref": "#/$defs/agency.shared.Digest"
    },
    "csrf_digest": {
      "$ref": "#/$defs/agency.shared.Digest"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "$ref": "#/$defs/agency.service.Session.State"
    }
  },
  "required": [
    "session_id",
    "principal_id",
    "kind",
    "token_digest",
    "opened_at",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "agency",
    "specification_version": "v1",
    "source_digest": "71132e90bde806415603d08bb97a71629b2c2f6cda30e1f22e76f407abd9a3eb",
    "contract_digest": "slice-sha256/2:a98d595e085a290c6ea7b87b0749b0c5d0633246f78e7160e52634b16bd4edf6",
    "regenerate": "ess generate"
  },
  "$defs": {

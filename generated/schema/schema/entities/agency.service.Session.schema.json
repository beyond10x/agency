    "agency.runs.RunId": {
      "title": "RunId",
      "x-ess-name": "agency.runs.RunId",
      "x-ess-kind": "newtype",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "agency.service.Session.State": {
      "title": "State",
      "x-ess-name": "agency.service.Session.State",
      "x-ess-kind": "enum",
      "type": "string",

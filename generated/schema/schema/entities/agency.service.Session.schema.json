{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session",
  "description": "One authenticated session of a principal, held by its token's digest.",
  "x-ess-name": "agency.service.Session",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "session_id": {
      "$ref": "#/$defs/agency.service.SessionId"
    },
    "principal_id": {
      "$ref": "#/$defs/agency.auth.PrincipalId",
      "x-ess-relation": {
        "name": "principal",
        "kind": "references",
        "source": "agency.service.Session",
        "target": "agency.auth.Principal",
        "cardinality": "one",
        "via": "principal_id"
      }
    },
    "kind": {
      "$ref": "#/$defs/agency.service.SessionKind"
    },
    "run_id": {
      "$ref": "#/$defs/agency.runs.RunId",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkItem",
  "description": "A unit of work handled by reference: its digest, assignment, state and timestamps. The body stays in its source.",
  "x-ess-name": "agency.work.WorkItem",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "item_ref": {
      "$ref": "#/$defs/agency.work.WorkItemRef"
    },
    "tenant_id": {
      "$ref": "#/$defs/agency.auth.TenantId",
      "x-ess-relation": {
        "name": "work_items",
        "kind": "owns",
        "source": "agency.auth.Tenant",
        "target": "agency.work.WorkItem",
        "cardinality": "many",
        "via": "tenant_id"
      }
    },
    "input_id": {
      "$ref": "#/$defs/agency.work.InputId",
      "x-ess-relation": {
        "name": "work_input",
        "kind": "references",
        "source": "agency.work.WorkItem",
        "target": "agency.work.WorkInput",
        "cardinality": "one",
        "via": "input_id"
      }
    },
    "title": {
      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/agency.shared.Digest"
    },
    "assigned_agent_id": {
      "$ref": "#/$defs/agency.agents.AgentId",
      "x-ess-relation": {
        "name": "agent",
        "kind": "references",
        "source": "agency.work.WorkItem",
        "target": "agency.agents.Agent",
        "cardinality": "one",
        "via": "assigned_agent_id"
      }
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "settled_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "$ref": "#/$defs/agency.work.WorkItem.State"
    }
  },
  "required": [
    "item_ref",
    "tenant_id",
    "input_id",
    "title",
    "payload_digest",
    "received_at",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "agency",
    "specification_version": "v1",
    "source_digest": "71132e90bde806415603d08bb97a71629b2c2f6cda30e1f22e76f407abd9a3eb",
    "contract_digest": "slice-sha256/2:75b2b2d7f0ed39631634a47f6cf66838ec13ce599869c28798b42f79c4feb9e1",
    "regenerate": "ess generate"
  },
